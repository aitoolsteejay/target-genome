# Google Gemini API key — https://aistudio.google.com/apikey
# Required for AI-generated reports. Without it, the app still runs fully:
# /api/generate-report silently falls back to the built-in heuristic
# sample-matching generator (see lib/report-generator.ts).
GEMINI_API_KEY=

# Optional — defaults to "gemini-2.5-flash" if unset.
GEMINI_MODEL=
