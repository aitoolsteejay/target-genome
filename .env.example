# Google Gemini API key, https://aistudio.google.com/apikey
# Used to write the executive summary and the "Where the Time Is Lost"
# recommendations. Every number in the report (hours, totals, percentages)
# always comes from lib/calculations.ts, never from Gemini.
#
# Without a key, /api/generate-report still works fully: it falls back to
# the built-in template text (see lib/calculations.ts) automatically.
GEMINI_API_KEY=

# Optional. Defaults to "gemini-flash-latest" (a Google-maintained alias
# that always points at the current recommended Flash model) if unset.
GEMINI_MODEL=
